@page "/login"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@layout EpsilonWebApp.Components.Layout.EmptyLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<MudGrid Justify="Justify.Center" Class="mt-16">
    <MudItem xs="12" sm="8" md="4">
        <MudPaper Class="pa-6" Elevation="3">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">Epsilon Login</MudText>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }

            <MudTextField @bind-Value="_username"
                          Label="Username"
                          Variant="Variant.Outlined"
                          Class="mb-3"
                          Disabled="_isLoading" />

            <MudTextField @bind-Value="_password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Class="mb-4"
                          Disabled="_isLoading" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       OnClick="HandleLogin"
                       Disabled="_isLoading">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Logging in...</span>
                }
                else
                {
                    <span>Login</span>
                }
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        var token = AuthService.GetToken();
        if (!string.IsNullOrEmpty(token))
            Navigation.NavigateTo("/customers");
    }

    private async Task HandleLogin()
    {
        _errorMessage = string.Empty;
        _isLoading = true;

        var success = await AuthService.LoginAsync(_username, _password);

        if (success)
            Navigation.NavigateTo("/customers"); // no forceLoad here
        else
            _errorMessage = "Invalid username or password.";

        _isLoading = false;
    }
}